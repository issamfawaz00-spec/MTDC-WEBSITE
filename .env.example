# Copy to .env.local and fill in. Never commit real values.

# Where enquiry forms are delivered. The site POSTs each validated enquiry
# as JSON to this URL and only shows "sent" when it answers with a 2xx status.
# Works with any webhook receiver (e.g. Formspree, Make/Zapier, n8n, a CRM,
# or MTDC's own backend). Leave empty to keep online enquiries switched off.
ENQUIRY_WEBHOOK_URL=

# Optional shared secret, sent as "Authorization: Bearer <value>".
ENQUIRY_WEBHOOK_SECRET=

# Public site URL, used for canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
